{
  // Worker thứ hai CHỈ cho trang admin (tuỳ chọn). Build variable: SITE_TARGET=admin ; Deploy command: npx wrangler deploy -c wrangler.admin.jsonc
  // Dùng chung database + bộ biến môi trường với Worker chính (đặt lại DATABASE_URL, TOKEN_SECRET, ADMIN_KEY... trong project này). Xem DEPLOY-CLOUDFLARE.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "night-play-admin",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Giữ nguyên biến môi trường đã nhập trên dashboard khi deploy (mặc định wrangler deploy XOÁ biến kiểu Text không có trong file này)
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
