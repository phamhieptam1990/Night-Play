PORT=3000
# openssl rand -hex 32
TOKEN_SECRET=
# Khoá bạn đặt khi tạo webhook ở SePay (Kiểu chứng thực: API Key)
SEPAY_API_KEY=
# Tài khoản nhận tiền (BIN xem tại https://api.vietqr.io/v2/banks)
BANK_BIN=970436
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=
BANK_NAME=Vietcombank
ORDER_TTL_MIN=15
# Khi sau reverse proxy (nginx/Cloudflare): 1
TRUST_PROXY=
# Chỉ dev: in OTP ra console
DEV_OTP_LOG=1

# (Tuỳ chọn, chỉ đặt trên Netlify) Mã truy cập tạm thời: có giá trị thì cả site đòi nhập mã mới vào được. Xoá biến để mở cửa.
ACCESS_CODE=

# --- Gửi email OTP khôi phục gói (chọn MỘT nhà cung cấp) ---
# Brevo (khuyên dùng khi chưa có tên miền): MAIL_FROM là địa chỉ đã xác minh Sender trong Brevo
BREVO_API_KEY=
# Resend (cần xác minh tên miền gửi thư):
RESEND_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Night Play
